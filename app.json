{
    "expo":  {
                 "name":  "Lobby",
                 "slug":  "mobile",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/lobby-icon.png",
                 "scheme":  "mobile",
                 "userInterfaceStyle":  "automatic",
                 "ios":  {
                             "icon":  "./assets/lobby-icon.png"
                         },
                 "android":  {
                                 "permissions":  [
                                                     "RECORD_AUDIO",
                                                     "ACCESS_FINE_LOCATION",
                                                     "ACCESS_COARSE_LOCATION"
                                                 ],
                                 "adaptiveIcon":  {
                                                      "backgroundColor":  "#05090D",
                                                      "foregroundImage": "./assets/lobby-icon-android.png"
                                                  },
                                 "predictiveBackGestureEnabled":  false,
                                 "package":  "com.anonymous.mobile"
                             },
                 "web":  {
                             "output":  "static",
                             "favicon":  "./assets/lobby-icon.png"
                         },
                 "plugins":  [
                                 "expo-router",
                                 "@config-plugins/react-native-webrtc",
                                 [
                                     "expo-splash-screen",
                                     {
                                         "backgroundColor":  "#05090D",
                                         "image":  "./assets/lobby-icon.png",
                                         "imageWidth":  180,
                                         "resizeMode":  "contain"
                                     }
                                 ]
                             ],
                 "experiments":  {
                                     "typedRoutes":  true,
                                     "reactCompiler":  true
                                 }
             }
}
